diff --git a/packages/core/src/__tests__/phase28-webhook.test.js b/packages/core/src/__tests__/phase28-webhook.test.js
new file mode 100644
index 0000000..b575209
--- /dev/null
+++ b/packages/core/src/__tests__/phase28-webhook.test.js
@@ -0,0 +1,26 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createHmac } from 'node:crypto';
+import { WebhookEngine } from '../webhook-engine.js';
+
+test('signed raw webhook includes only the bound observation reference, with no real delivery', async () => {
+  let boundQuery, sent;
+  const engine = new WebhookEngine({ db: {
+    queryOne(sql, args) { boundQuery = { sql, args }; return { bank_reference_number: '123456789012' }; }, execute() {},
+  }, merchantRepo: { findById() { return { id: 'merchant', webhookUrl: 'https://example.org/webhook', webhookSecret: 'synthetic-secret' }; } } });
+  const original = globalThis.fetch;
+  globalThis.fetch = async (_url, init) => { sent = init; return new Response('{}'); };
+  try {
+    await engine.dispatch('SUCCESS', { id: 'payment', merchantId: 'merchant', orderId: 'CN-test',
+      attributedObservationId: 'observation', amountPaise: 100n, currency: 'INR', method: 'UPI' });
+    assert.deepEqual(boundQuery.args, ['observation', 'payment', 100]);
+    assert.match(boundQuery.sql, /attributed_payment_id = \? AND amount_paise = \?/);
+    assert.equal(JSON.parse(sent.body).utr, '123456789012');
+    assert.equal(sent.headers['X-Gateway-Signature'], 'sha256=' + createHmac('sha256', 'synthetic-secret').update(sent.body).digest('hex'));
+    boundQuery = undefined;
+    await engine.dispatch('SUCCESS', { id: 'cod', merchantId: 'merchant', orderId: 'CN-cod', amountPaise: 100n, method: 'COD' });
+    assert.equal(JSON.parse(sent.body).utr, null);
+    assert.equal(JSON.parse(sent.body).method, 'COD');
+    assert.equal(boundQuery, undefined);
+  } finally { globalThis.fetch = original; }
+});
