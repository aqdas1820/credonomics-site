+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import vm from 'node:vm';
+import { registerPaymentRoutes } from '../../../payment-api/src/routes/payments.routes.js';
+
+test('unsupported promotional slots stay hidden before JS and cannot use branding overrides', () => {
+  const html = readFileSync(new URL('../views/checkout.html', import.meta.url), 'utf8');
+  assert.doesNotMatch(html, /Trusted Business|Verified Business|500\+ orders|100% Payment Protection|Verified & Protected|200\+ orders/i);
+  assert.match(html, /#headerTrustBadge, #headerSubbanner, #pcTrustBadge, #pcSocialProofWrap\s*\{\s*display: none !important;/);
+  assert.doesNotMatch(html, /b\.trustBadgeText|b\.subbannerText/);
+  // Parse every inline script without a browser or contacting a gateway.
+  for (const [, script] of html.matchAll(/<script(?:\s[^>]*)?>([\s\S]*?)<\/script>/g)) {
+    if (script.trim()) new vm.Script(script);
+  }
+});
+
+test('merchant identity is returned only to the authenticated payment owner', async () => {
+  const handlers = new Map();
+  const server = { get(path, fn) { handlers.set(path, fn); }, post() {}, delete() {} };
+  const session = { id: 'test-payment', merchantId: 'owner', orderId: 'CN-test', amountPaise: 100n,
+    currency: 'INR', status: 'INITIATED', method: 'UPI', metadata: { private: true } };
+  registerPaymentRoutes(server, { sessionRepo: { findById() { return session; } },
+    merchantRepo: { findById() { return { webhookSecret: 'synthetic-owner-key' }; } } });
+  async function read(headers) {
+    let body;
+    const res = { writeHead() {}, end(value) { body = JSON.parse(value); } };
+    await handlers.get('/api/v1/payments/:id')({ headers }, res, { id: session.id });
+    return body;
+  }
+  assert.equal((await read({})).merchantId, undefined);
+  assert.equal((await read({ 'x-merchant-key': 'wrong-owner' })).merchantId, undefined);
+  const owner = await read({ 'x-merchant-key': 'synthetic-owner-key' });
+  assert.equal(owner.merchantId, 'owner');
+  assert.deepEqual(owner.metadata, { private: true });
+});
