+    // Only carry a bank reference from the observation attributed to this session.
+    // No synthetic UTR for COD/counter orders or sessions without bank evidence.
+    const observation = session.attributedObservationId ? this.db.queryOne(
+      'SELECT bank_reference_number FROM payment_observations WHERE id = ? AND attributed_payment_id = ? AND amount_paise = ?',
+      [session.attributedObservationId, session.id, Number(session.amountPaise)]
+    ) : null;
+
     const payloadObj = {
       event: publicOutcome,
       paymentId: session.id,
@@ -45,6 +52,7 @@ export class WebhookEngine {
       amountPaise: Number(session.amountPaise),
       currency: session.currency || 'INR',
       method: session.method || 'UPI',
+      utr: observation?.bank_reference_number || null,
       completedAt: session.completedAt ? session.completedAt.toISOString() : new Date().toISOString(),
       metadata: session.metadata || {}
     };
