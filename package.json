{
  "name": "credonomics-site",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "prebuild": "npm run test:billing && node scripts/generate-ipo-dashboard.mjs && node scripts/generate-search-index.mjs",
    "ipo:refresh": "python scripts/ipo_auto_fetch/fetch_ipo_intelligence.py",
    "ipo:generate": "node scripts/generate-ipo-dashboard.mjs",
    "lint": "next lint",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "vitest run",
    "test:smoke": "playwright test",
    "mf:metadata": "node scripts/mf/enrich-v2-metadata.mjs",
    "mf:generate": "node scripts/mf/generate.mjs",
    "mf:publish": "node scripts/mf/publish.mjs",
    "mf:validate": "node scripts/mf/validate-production.mjs",
    "equity:instruments:fetch": "node scripts/equity/fetch-instruments.mjs",
    "equity:instruments:validate": "node scripts/equity/validate-instruments.mjs",
    "equity:instruments:publish": "node scripts/equity/publish-instruments.mjs",
    "test:billing": "vitest run app/billing src/lib/billing"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.113.0",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^0.468.0",
    "next": "15.5.28",
    "pdf-lib": "1.17.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "regenerator-runtime": "0.14.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^20.14.12",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.28",
    "typescript": "^5.5.4",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "postcss": "8.5.30",
    "source-map-js": "1.2.2",
    "brace-expansion@<2": "1.1.21",
    "brace-expansion@>=4": "5.0.12"
  }
}
