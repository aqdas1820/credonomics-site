{
  "name": "credonomics-site",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "npm run build",
    "start": "next start",
    "prebuild": "node scripts/generate-ipo-dashboard.mjs && node scripts/generate-search-index.mjs",
    "ipo:refresh": "python scripts/ipo_auto_fetch/fetch_ipo_intelligence.py",
    "ipo:generate": "node scripts/generate-ipo-dashboard.mjs",
    "lint": "eslint app src middleware.ts instrumentation.ts instrumentation-client.ts sentry.server.config.ts sentry.edge.config.ts tests --ext .ts,.tsx",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "vitest run",
    "test:smoke": "playwright test",
    "mf:metadata": "node scripts/mf/enrich-v2-metadata.mjs",
    "mf:generate": "node scripts/mf/generate.mjs",
    "mf:publish": "node scripts/mf/publish.mjs",
    "mf:validate": "node scripts/mf/validate-production.mjs",
    "equity:instruments:fetch": "node scripts/equity/fetch-instruments.mjs",
    "equity:instruments:validate": "node scripts/equity/validate-instruments.mjs",
    "equity:instruments:publish": "node scripts/equity/publish-instruments.mjs"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.73.0",
    "@stripe/stripe-js": "^9.15.0",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.113.0",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^0.468.0",
    "next": "15.5.26",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "resend": "^6.26.0",
    "stripe": "^22.6.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.62.1",
    "@types/node": "^20.14.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.26",
    "playwright": "^1.63.0",
    "typescript": "^5.5.4",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "postcss": "^8.5.28"
  }
}
