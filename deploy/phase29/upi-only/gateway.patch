diff --git a/apps/payment-api/src/upi-only.js b/apps/payment-api/src/upi-only.js
new file mode 100644
index 0000000..f0ad6b3
--- /dev/null
+++ b/apps/payment-api/src/upi-only.js
@@ -0,0 +1,42 @@
+import { HttpServer } from './server.js';
+
+// Historical enums/rows remain readable by the private merchant dashboard.
+// They are never executable checkout or settlement instructions.
+export function assertUpiOnly(input) {
+  if (!input || typeof input !== 'object') return;
+  for (const [key, value] of Object.entries(input)) {
+    if ((['method', 'paymentMethod', 'payment_method'].includes(key) && value !== 'UPI') ||
+        (['enabledMethods', 'enabledPaymentMethods'].includes(key) && (!Array.isArray(value) || value.some(v => v !== 'UPI'))) ||
+        (['codEnabled', 'cashEnabled', 'cardEnabled'].includes(key) && value !== false)) {
+      throw Object.assign(new Error('UPI_ONLY'), { status: 400 });
+    }
+    assertUpiOnly(value);
+  }
+}
+
+export function effectiveUpiSettings(value) {
+  if (!value || typeof value !== 'object' || value instanceof Date) return value;
+  if (Array.isArray(value)) return value.map(effectiveUpiSettings);
+  return Object.fromEntries(Object.entries(value).map(([k,v]) => [k,
+    ['enabledMethods','enabledPaymentMethods'].includes(k) ? ['UPI'] :
+    ['codEnabled','cashEnabled','cardEnabled'].includes(k) ? false : effectiveUpiSettings(v)]));
+}
+
+export function installUpiOnlyGuard(server, sessionRepo) {
+  server.use(async (req,res,pathname) => {
+    if (/\/(?:checkout|payments)\/[^/]+\/(confirm-cod|cod)$/.test(pathname) || /\/orders\/[^/]+\/cod$/.test(pathname) || ['/api/v1/admin/counter-confirm','/api/v1/admin/cod-orders'].includes(pathname)) {
+      HttpServer.json(res,410,{error:'PAYMENT_METHOD_REMOVED'}); return true;
+    }
+    const match=pathname.match(/^\/api\/v1\/(?:checkout|payments)\/([^/]+)(?:\/|$)/);
+    const session=match && sessionRepo.findById(match[1]);
+    if(session && session.method !== 'UPI') {
+      HttpServer.json(res,410,{error:'LEGACY_PAYMENT_METHOD_UNSUPPORTED'}); return true;
+    }
+    if (['POST','PUT','PATCH'].includes(req.method) && /^\/api\/v1\//.test(pathname)) {
+      // Cache the bounded body for the original route, avoiding a second stream read.
+      try { req.upiValidatedBody=await HttpServer.parseBody(req); assertUpiOnly(req.upiValidatedBody); }
+      catch { HttpServer.json(res,400,{error:'UPI_ONLY_OR_INVALID_BODY'}); return true; }
+    }
+    return false;
+  });
+}
