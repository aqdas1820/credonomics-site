+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import crypto from 'node:crypto';
+import fs from 'node:fs';
+import vm from 'node:vm';
+import { Database } from '@youpi/db';
+import { WebhookEngine } from '@youpi/core';
+import { startServer } from '../index.js';
+// Self-contained test credentials; no real environment or host secret mounts.
+for(const name of ['ADMIN_API_TOKEN','OBSERVER_API_TOKEN','INTERNAL_SERVICE_TOKEN','ENCRYPTION_MASTER_KEY','COIN_STORE_WEBHOOK_SECRET'])process.env[name]=crypto.randomBytes(32).toString('hex');
+const TEST_ADMIN_TOKEN=process.env.ADMIN_API_TOKEN;
+
+test('UPI-only APIs preserve history and reject executable non-UPI instructions', async t => {
+  const db=new Database({inMemory:true});
+  const api=await startServer(0,db);
+  t.after(async()=>{await api.close();db.close();});
+  const call=(path,body,admin=false)=>fetch(`http://127.0.0.1:${api.port}${path}`,{
+    method:body===undefined?'GET':'POST',headers:{'Content-Type':'application/json',...(admin?{Authorization:'Bearer '+TEST_ADMIN_TOKEN}:{})},
+    body:body===undefined?undefined:JSON.stringify(body)});
+  const create=body=>call('/api/v1/payments',{orderId:crypto.randomUUID(),amount:'1.00',...body});
+  await t.test('direct creation, nested overrides and coercion cannot enable COD',async()=>{
+    for(const method of ['COD','cod','CASH_COUNTER','CARD_COUNTER','UPI ',null,{},['UPI','COD']])assert.equal((await create({method})).status,400);
+    assert.equal((await create({metadata:{paymentMethod:'COD'}})).status,400);
+  });
+  const good=await create({method:'UPI'});assert.equal(good.status,201);
+  const id=(await good.json()).paymentId;
+  await t.test('removed routes and method-switch reject without changing a UPI session',async()=>{
+    const before=db.queryOne('SELECT * FROM payment_sessions WHERE id=?',[id]);
+    for(const route of [`/api/v1/checkout/${id}/confirm-cod`,`/api/v1/checkout/${id}/cod`,`/api/v1/payments/${id}/cod`,`/api/v1/orders/anything/cod`]){
+      const res=await call(route,route.endsWith('confirm-cod')?{}:undefined);assert.ok([404,410].includes(res.status));
+    }
+    assert.equal((await call(`/api/v1/checkout/${id}/select-method`,{method:'COD'})).status,400);
